# Copie este arquivo para ".env" e preencha com os dados do seu projeto do Supabase.
# Onde achar: painel do Supabase > Project Settings > API.
# Use SÓ a chave pública (publishable/anon). NUNCA coloque a chave "service_role" aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_COLE_A_SUA_CHAVE_AQUI
